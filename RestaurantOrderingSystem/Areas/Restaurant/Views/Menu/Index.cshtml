@model List<RestaurantOrderingSystem.Models.Menu.MenuItem>

@{
    ViewData["Title"] = "Menu Management";
    Layout = "~/Areas/Restaurant/Views/Shared/_LayoutResto.cshtml";

    var totalItems = Model.Count;
    var availableItems = Model.Count(x => x.IsAvailable && x.IsActive);
    var unavailableItems = Model.Count(x => !x.IsAvailable || !x.IsActive);
    var activeCategories = Model
        .Where(x => x.Category != null && x.IsActive)
        .Select(x => x.Category!.Name)
        .Distinct()
        .Count();

    var categoryNames = Model
        .Where(x => x.Category != null)
        .Select(x => x.Category!.Name)
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<style>
    .menu-page {
        padding: 28px;
        background: #f7f8fa;
        min-height: calc(100vh - 70px);
    }

    .menu-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        gap: 20px;
    }

    .menu-header-left h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #202124;
    }

    .menu-header-left p {
        margin: 7px 0 0;
        color: #737780;
        font-size: 14px;
    }

    .menu-actions {
        display: flex;
        gap: 10px;
    }

    .menu-btn {
        text-decoration: none;
        border-radius: 9px;
        padding: 11px 17px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: 0.2s ease;
        border: none;
        cursor: pointer;
    }

    .menu-btn-secondary {
        background: #ffffff;
        color: #30343b;
        border: 1px solid #dfe2e7;
    }

        .menu-btn-secondary:hover {
            background: #f1f3f5;
            color: #202124;
        }

    .menu-btn-primary {
        background: #ff6b35;
        color: white;
        border: 1px solid #ff6b35;
    }

        .menu-btn-primary:hover {
            background: #e85a28;
            color: white;
        }

    /* ================= SUMMARY ================= */

    .menu-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #e7e9ed;
        border-radius: 12px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .summary-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        background: #f2f3f5;
    }

    .summary-content span {
        display: block;
        font-size: 13px;
        color: #777d86;
        margin-bottom: 4px;
    }

    .summary-content strong {
        font-size: 22px;
        color: #202124;
    }

    /* ================= TOOLBAR ================= */

    .menu-toolbar {
        background: #ffffff;
        border: 1px solid #e7e9ed;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .menu-search {
        width: 320px;
        position: relative;
    }

        .menu-search input {
            width: 100%;
            height: 42px;
            border: 1px solid #dfe2e7;
            border-radius: 8px;
            padding: 0 14px 0 40px;
            outline: none;
            font-size: 14px;
        }

            .menu-search input:focus {
                border-color: #ff6b35;
            }

    .menu-search-icon {
        position: absolute;
        left: 14px;
        top: 11px;
        color: #8a9098;
    }

    .menu-filter {
        display: flex;
        gap: 8px;
    }

    .filter-btn {
        border: 1px solid #dfe2e7;
        background: #ffffff;
        padding: 9px 14px;
        border-radius: 8px;
        font-size: 13px;
        cursor: pointer;
        color: #555b63;
    }

        .filter-btn.active {
            background: #202124;
            color: #ffffff;
            border-color: #202124;
        }

    .category-select {
        height: 42px;
        border: 1px solid #dfe2e7;
        border-radius: 8px;
        padding: 0 12px;
        font-size: 13px;
        color: #30343b;
        background: #ffffff;
        cursor: pointer;
        outline: none;
        min-width: 180px;
    }

        .category-select:focus {
            border-color: #ff6b35;
        }

    /* ================= LIST TABLE ================= */

    .menu-table-card {
        background: #ffffff;
        border: 1px solid #e7e9ed;
        border-radius: 14px;
        overflow: hidden;
    }

    .menu-table {
        width: 100%;
        border-collapse: collapse;
    }

        .menu-table thead th {
            background: #fafbfc;
            color: #767c85;
            text-align: left;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 13px 16px;
            border-bottom: 1px solid #e7e9ed;
            white-space: nowrap;
        }

        .menu-table tbody td {
            padding: 12px 16px;
            border-bottom: 1px solid #f1f2f4;
            font-size: 13px;
            color: #30343b;
            vertical-align: middle;
        }

        .menu-table tbody tr:last-child td {
            border-bottom: none;
        }

        .menu-table tbody tr:hover {
            background: #fafbfc;
        }

    .row-item {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .row-thumb {
        width: 48px;
        height: 48px;
        border-radius: 9px;
        object-fit: cover;
        background: #f0f1f3;
        flex-shrink: 0;
    }

    .row-thumb-empty {
        width: 48px;
        height: 48px;
        border-radius: 9px;
        background: #f0f1f3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
        color: #b2b7bd;
    }

    .row-name {
        font-weight: 650;
        color: #202124;
    }

    .row-desc {
        font-size: 11px;
        color: #8a9098;
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .category-pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        background: #fff1ea;
        color: #ff6b35;
        font-size: 11px;
        font-weight: 650;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 650;
    }

    .status-available {
        background: #e8f7ee;
        color: #198754;
    }

    .status-unavailable {
        background: #fdecec;
        color: #dc3545;
    }

    .row-price {
        font-weight: 700;
        color: #202124;
    }

    /* ================= INLINE PRICE EDIT ================= */

    .price-view {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .price-edit-btn {
        border: none;
        background: none;
        cursor: pointer;
        font-size: 12px;
        opacity: 0.6;
        padding: 2px;
    }

        .price-edit-btn:hover {
            opacity: 1;
        }

    .price-edit-form {
        display: none;
        align-items: center;
        gap: 5px;
    }

        .price-edit-form.open {
            display: flex;
        }

    .price-symbol-inline {
        font-size: 13px;
        color: #6d737b;
        font-weight: 600;
    }

    .price-input-inline {
        width: 85px;
        height: 32px;
        border: 1px solid #dfe2e7;
        border-radius: 7px;
        padding: 0 8px;
        font-size: 13px;
        outline: none;
    }

        .price-input-inline:focus {
            border-color: #ff6b35;
        }

    .price-save-btn,
    .price-cancel-btn {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        border: 1px solid #dfe2e7;
        background: #ffffff;
        cursor: pointer;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .price-save-btn {
        color: #198754;
        border-color: #bfe5cf;
    }

        .price-save-btn:hover {
            background: #e8f7ee;
        }

    .price-cancel-btn {
        color: #dc3545;
        border-color: #f3c6c9;
    }

        .price-cancel-btn:hover {
            background: #fdecec;
        }

    /* ================= DISABLE / ENABLE TOGGLE ================= */

    .toggle-btn {
        border-radius: 8px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
        border: 1px solid;
        white-space: nowrap;
    }

    .toggle-disable {
        background: #ffffff;
        color: #dc3545;
        border-color: #f3c6c9;
    }

        .toggle-disable:hover {
            background: #fdecec;
        }

    .toggle-enable {
        background: #ffffff;
        color: #198754;
        border-color: #bfe5cf;
    }

        .toggle-enable:hover {
            background: #e8f7ee;
        }

    /* ================= ACTIONS DROPDOWN ================= */

    .actions-wrap {
        position: relative;
        display: inline-block;
    }

    .actions-btn {
        border: 1px solid #dfe2e7;
        background: #ffffff;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: #555b63;
    }

        .actions-btn:hover {
            background: #f5f6f7;
        }

    .actions-menu {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        min-width: 160px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.10);
        z-index: 20;
        overflow: hidden;
    }

        .actions-menu.open {
            display: block;
        }

        .actions-menu a,
        .actions-menu button {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
            text-align: left;
            padding: 10px 14px;
            font-size: 13px;
            color: #30343b;
            background: none;
            border: none;
            cursor: pointer;
            text-decoration: none;
        }

            .actions-menu a:hover,
            .actions-menu button:hover {
                background: #f5f6f7;
            }

            .actions-menu button.danger {
                color: #dc3545;
            }

    /* ================= EMPTY ================= */

    .empty-menu {
        background: #ffffff;
        border: 1px dashed #d5d8dd;
        border-radius: 14px;
        padding: 70px 20px;
        text-align: center;
    }

    .empty-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .empty-menu h3 {
        margin: 0 0 7px;
        color: #30343b;
    }

    .empty-menu p {
        color: #777d86;
        font-size: 14px;
        margin-bottom: 20px;
    }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 1100px) {
        .menu-summary {
            grid-template-columns: repeat(2, 1fr);
        }

        .menu-table-card {
            overflow-x: auto;
        }

        .menu-table {
            min-width: 760px;
        }
    }

    @@media (max-width: 700px) {
        .menu-page {
            padding: 18px;
        }

        .menu-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .menu-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .menu-search {
            width: 100%;
        }

        .menu-summary {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="menu-page">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="menu-header">

        <div class="menu-header-left">

            <h1>Menu Management</h1>

            <p>
                Manage your restaurant categories and menu items
            </p>

        </div>

        <div class="menu-actions">

            <a href="/Restaurant/Category/Index"
               class="menu-btn menu-btn-secondary">

                🏷️
                Categories

            </a>

            <a href="/Restaurant/Menu/Create"
               class="menu-btn menu-btn-primary">

                ＋
                Add Menu Item

            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- ========================================================= -->
    <!-- SUMMARY -->
    <!-- ========================================================= -->

    <div class="menu-summary">

        <div class="summary-card">

            <div class="summary-icon">
                🍴
            </div>

            <div class="summary-content">

                <span>Total Items</span>

                <strong>
                    @totalItems
                </strong>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon">
                ✅
            </div>

            <div class="summary-content">

                <span>Available</span>

                <strong>
                    @availableItems
                </strong>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon">
                ⛔
            </div>

            <div class="summary-content">

                <span>Unavailable</span>

                <strong>
                    @unavailableItems
                </strong>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon">
                🏷️
            </div>

            <div class="summary-content">

                <span>Categories</span>

                <strong>
                    @activeCategories
                </strong>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SEARCH + FILTER -->
    <!-- ========================================================= -->

    <div class="menu-toolbar">

        <div class="menu-search">

            <span class="menu-search-icon">
                🔍
            </span>

            <input type="text"
                   id="menuSearch"
                   placeholder="Search menu items..." />

        </div>


        <div class="menu-filter">

            <select id="categoryFilter" class="category-select">

                <option value="all">All Categories</option>

                @foreach (var catName in categoryNames)
                {
                    <option value="@catName.ToLower()">@catName</option>
                }

            </select>

            <button type="button"
                    class="filter-btn active"
                    data-filter="all">

                All

            </button>

            <button type="button"
                    class="filter-btn"
                    data-filter="available">

                Available

            </button>

            <button type="button"
                    class="filter-btn"
                    data-filter="unavailable">

                Unavailable

            </button>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MENU LIST -->
    <!-- ========================================================= -->
    @if (!Model.Any())
    {
        <div class="empty-menu">

            <div class="empty-icon">
                🍽️
            </div>

            <h3>
                Your menu is empty
            </h3>

            <p>
                Start building your digital menu by adding your first item.
            </p>

            <a href="/Restaurant/Menu/Create"
               class="menu-btn menu-btn-primary">

                ＋ Add Your First Menu Item

            </a>

        </div>
    }
    else
    {
        <div class="menu-table-card">

            <table class="menu-table" id="menuTable">

                <thead>

                    <tr>
                        <th>Item</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th></th>
                        <th style="text-align:right;">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr class="menu-row"
                            data-name="@item.Name.ToLower()"
                            data-category="@(item.Category?.Name.ToLower() ?? "")"
                            data-available="@((item.IsAvailable && item.IsActive).ToString().ToLower())">

                            <!-- ITEM (image + name + description) -->
                            <td>

                                <div class="row-item">

                                    @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                    {
                                        <img src="@item.ImagePath"
                                             class="row-thumb"
                                             alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="row-thumb-empty">
                                            🍽️
                                        </div>
                                    }

                                <div>

                                    <div class="row-name">
                                        @item.Name
                                    </div>

                                    <div class="row-desc">
                                        @(string.IsNullOrWhiteSpace(item.Description)
                                                                            ? "No description"
                                                                            : item.Description)
                                </div>

                                    </div>

                                </div>

                            </td>

                            <!-- CATEGORY -->
                            <td>
                                <span class="category-pill">
                                    @(item.Category?.Name ?? "Uncategorized")
                                </span>
                            </td>

                            <!-- PRICE -->
                            <td>

                                <div class="price-view"
                                     id="priceView_@item.Id">

                                    <span class="row-price">
                                        ₹@item.Price.ToString("0.00")
                                    </span>

                                    <button type="button"
                                            class="price-edit-btn"
                                            onclick="showPriceEdit(@item.Id)"
                                            title="Edit price">
                                        ✏️
                                    </button>

                                </div>

                                <form action="/Restaurant/Menu/UpdatePrice"
                                      method="post"
                                      id="priceForm_@item.Id"
                                      class="price-edit-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <span class="price-symbol-inline">₹</span>

                                    <input type="number"
                                           name="price"
                                           step="0.01"
                                           min="0.01"
                                           value="@item.Price"
                                           class="price-input-inline" />

                                    <button type="submit"
                                            class="price-save-btn"
                                            title="Save">
                                        ✔
                                    </button>

                                    <button type="button"
                                            class="price-cancel-btn"
                                            onclick="hidePriceEdit(@item.Id)"
                                            title="Cancel">
                                        ✕
                                    </button>

                                </form>

                            </td>

                            <!-- STATUS -->
                            <td>
                        @if (item.IsAvailable && item.IsActive)
                                {
                                    <span class="status-pill status-available">
                                        ● Available
                                    </span>
                                }
                                else
                                {
                                    <span class="status-pill status-unavailable">
                                        ● Unavailable
                                    </span>
                                }
                            </td>

                            <!-- DISABLE / ENABLE TOGGLE -->
                            <td>

                                @if (item.IsActive)
                                {
                                    <form action="/Restaurant/Menu/Delete"
                                          method="post"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="toggle-btn toggle-disable"
                                                onclick="return confirm('Disable this menu item? It will no longer be available to customers.');">
                                            Disable
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <form action="/Restaurant/Menu/Activate"
                                          method="post"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="toggle-btn toggle-enable">
                                            Enable
                                        </button>

                                    </form>
                                }

                            </td>

                            <!-- ACTIONS -->
                            <td style="text-align:right;">

                                <a href="/Restaurant/Menu/Edit/@item.Id"
                                   class="actions-btn"
                                   style="text-decoration:none;"
                                   title="Edit">
                                    ✏️
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>


<!-- ============================================================= -->
<!-- SEARCH + FILTER + ACTIONS JAVASCRIPT -->
<!-- ============================================================= -->

<script>

    const searchInput =
        document.getElementById("menuSearch");

    const categoryFilter =
        document.getElementById("categoryFilter");

    const menuRows =
        document.querySelectorAll(".menu-row");

    const filterButtons =
        document.querySelectorAll(".filter-btn");


    let currentFilter = "all";


    function filterMenu() {

        const searchText =
            searchInput
                ? searchInput.value.toLowerCase().trim()
                : "";

        const selectedCategory =
            categoryFilter
                ? categoryFilter.value
                : "all";


        menuRows.forEach(row => {

            const name =
                row.dataset.name || "";

            const category =
                row.dataset.category || "";

            const available =
                row.dataset.available === "true";


            const matchesSearch =
                name.includes(searchText);

            const matchesCategory =
                selectedCategory === "all" ||
                category === selectedCategory;


            let matchesFilter = true;


            if (currentFilter === "available") {

                matchesFilter = available;

            }
            else if (currentFilter === "unavailable") {

                matchesFilter = !available;

            }


            row.style.display =
                matchesSearch && matchesCategory && matchesFilter
                    ? ""
                    : "none";

        });

    }


    if (searchInput) {

        searchInput.addEventListener(
            "input",
            filterMenu
        );

    }


    if (categoryFilter) {

        categoryFilter.addEventListener(
            "change",
            filterMenu
        );

    }


    filterButtons.forEach(button => {

        button.addEventListener(
            "click",
            function () {

                filterButtons.forEach(btn =>
                    btn.classList.remove("active")
                );


                this.classList.add("active");


                currentFilter =
                    this.dataset.filter;


                filterMenu();

            }
        );

    });


    // =====================================================
    // ACTIONS DROPDOWN
    // =====================================================

    function toggleActions(button) {

        const menu =
            button.nextElementSibling;

        const isOpen =
            menu.classList.contains("open");


        document
            .querySelectorAll(".actions-menu.open")
            .forEach(m => m.classList.remove("open"));


        if (!isOpen) {
            menu.classList.add("open");
        }

    }


    document.addEventListener("click", function (event) {

        if (!event.target.closest(".actions-wrap")) {

            document
                .querySelectorAll(".actions-menu.open")
                .forEach(m => m.classList.remove("open"));

        }

    });


    // =====================================================
    // INLINE PRICE EDIT
    // =====================================================

    function showPriceEdit(id) {

        document.getElementById("priceView_" + id).style.display = "none";

        const form =
            document.getElementById("priceForm_" + id);

        form.classList.add("open");

        form.querySelector(".price-input-inline").focus();

    }


    function hidePriceEdit(id) {

        document.getElementById("priceView_" + id).style.display = "flex";

        document
            .getElementById("priceForm_" + id)
            .classList.remove("open");

    }

</script>
