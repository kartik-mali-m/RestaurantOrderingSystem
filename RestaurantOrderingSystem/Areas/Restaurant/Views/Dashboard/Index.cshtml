@{
    ViewData["Title"] = "Restaurant Dashboard";
    Layout = null;
    Layout = "~/Areas/Restaurant/Views/Shared/_LayoutResto.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Restaurant Admin Dashboard</title>

    <style>
        :root {
            --bg: #f5f7fb;
            --card: #ffffff;
            --border: #e5e7eb;
            --primary: #635bff;
            --primary-light: #eeecff;
            --green: #16a34a;
            --green-light: #dcfce7;
            --orange: #f59e0b;
            --orange-light: #fef3c7;
            --red: #ef4444;
            --red-light: #fee2e2;
            --blue: #2563eb;
            --blue-light: #dbeafe;
            --purple: #7c3aed;
            --purple-light: #ede9fe;
            --text: #111827;
            --muted: #6b7280;
            --radius: 16px;
            --shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        body {
            background: var(--bg);
            color: var(--text);
        }

        button,
        a {
            font-family: inherit;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* =========================
                           MAIN
                        ========================= */

        .main {
            min-height: 100vh;
        }

        /* =========================
                           TOPBAR
                        ========================= */

        .topbar {
            height: 76px;
            background: white;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 500;
        }

        .page-title h1 {
            font-size: 22px;
            font-weight: 750;
        }

        .page-title p {
            margin-top: 3px;
            font-size: 12px;
            color: var(--muted);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .date-box {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 9px 12px;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 12px;
            color: #374151;
            background: #fff;
        }

        .notification {
            width: 38px;
            height: 38px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: white;
            cursor: pointer;
            position: relative;
        }

            .notification span {
                position: absolute;
                right: 5px;
                top: 4px;
                width: 7px;
                height: 7px;
                background: var(--red);
                border-radius: 50%;
            }

        .profile {
            display: flex;
            align-items: center;
            gap: 9px;
            padding-left: 8px;
        }

        .profile-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ddd6fe, #c4b5fd);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #4c1d95;
        }

        .profile-info strong {
            display: block;
            font-size: 12px;
        }

        .profile-info span {
            font-size: 10px;
            color: var(--muted);
        }

        /* =========================
                           CONTENT
                        ========================= */

        .content {
            padding: 26px 30px 40px;
        }

        /* =========================
                           KPI CARDS
                        ========================= */

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
            margin-bottom: 18px;
        }

        .kpi-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 17px;
            box-shadow: var(--shadow);
            transition: .2s;
            cursor: pointer;
        }

            .kpi-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 9px 25px rgba(15,23,42,.09);
            }

        .kpi-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .kpi-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .icon-purple {
            background: var(--purple-light);
            color: var(--purple);
        }

        .icon-blue {
            background: var(--blue-light);
            color: var(--blue);
        }

        .icon-green {
            background: var(--green-light);
            color: var(--green);
        }

        .icon-orange {
            background: var(--orange-light);
            color: var(--orange);
        }

        .icon-red {
            background: var(--red-light);
            color: var(--red);
        }

        .kpi-label {
            color: var(--muted);
            font-size: 11px;
            font-weight: 650;
            margin-top: 13px;
        }

        .kpi-value {
            font-size: 24px;
            font-weight: 800;
            margin-top: 3px;
        }

        .kpi-footer {
            display: flex;
            justify-content: space-between;
            margin-top: 8px;
            font-size: 10px;
        }

        .positive {
            color: var(--green);
            font-weight: 700;
        }

        .muted {
            color: var(--muted);
        }

        /* =========================
                           QUICK ACTIONS
                        ========================= */

        .section-label {
            font-size: 13px;
            font-weight: 750;
            margin-bottom: 10px;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 10px;
            margin-bottom: 22px;
        }

        .quick-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 11px;
            cursor: pointer;
            transition: .2s;
        }

            .quick-card:hover {
                border-color: #c7c4ff;
                background: #fafaff;
                transform: translateY(-1px);
            }

        .quick-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-light);
            color: var(--primary);
        }

        .quick-text strong {
            display: block;
            font-size: 11px;
        }

        .quick-text span {
            font-size: 9px;
            color: var(--muted);
        }

        /* =========================
                           MAIN GRID
                        ========================= */

        .main-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.65fr) minmax(320px, .9fr);
            gap: 18px;
        }

        .card {
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .card-header {
            padding: 17px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
        }

            .card-header h3 {
                font-size: 14px;
                font-weight: 750;
            }

            .card-header p {
                margin-top: 3px;
                color: var(--muted);
                font-size: 10px;
            }

        .view-link {
            color: var(--primary);
            font-size: 11px;
            font-weight: 700;
        }

        /* =========================
                           LIVE ORDERS
                        ========================= */

        .orders-table {
            width: 100%;
            border-collapse: collapse;
        }

            .orders-table th {
                background: #fafafa;
                color: #6b7280;
                text-align: left;
                font-size: 9px;
                font-weight: 750;
                padding: 11px 14px;
                border-bottom: 1px solid var(--border);
                text-transform: uppercase;
            }

            .orders-table td {
                padding: 13px 14px;
                border-bottom: 1px solid #f1f1f1;
                font-size: 11px;
                white-space: nowrap;
            }

            .orders-table tbody tr:hover {
                background: #fafaff;
            }

        .order-id {
            font-weight: 750;
            color: #374151;
        }

        .customer {
            font-weight: 600;
        }

        .type-badge,
        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 5px 8px;
            border-radius: 7px;
            font-size: 9px;
            font-weight: 750;
        }

        .type-dine {
            background: var(--purple-light);
            color: var(--purple);
        }

        .type-online {
            background: var(--orange-light);
            color: #b45309;
        }

        .status-preparing {
            background: var(--orange-light);
            color: #b45309;
        }

        .status-confirmed {
            background: var(--green-light);
            color: #15803d;
        }

        .status-ready {
            background: var(--blue-light);
            color: #1d4ed8;
        }

        .status-delivery {
            background: var(--red-light);
            color: #b91c1c;
        }

        .table-number {
            background: #f3f4f6;
            padding: 4px 7px;
            border-radius: 6px;
            font-size: 9px;
            font-weight: 750;
        }

        .order-actions {
            display: flex;
            gap: 5px;
        }

        .small-btn {
            border: 1px solid var(--border);
            background: white;
            padding: 5px 7px;
            border-radius: 6px;
            font-size: 9px;
            cursor: pointer;
        }

            .small-btn.primary {
                background: var(--primary);
                color: white;
                border-color: var(--primary);
            }

        /* =========================
                           SUMMARY
                        ========================= */

        .summary-body {
            padding: 18px;
        }

        .revenue-number {
            font-size: 30px;
            font-weight: 850;
        }

        .revenue-change {
            margin-top: 4px;
            font-size: 10px;
        }

        .chart {
            height: 135px;
            margin-top: 20px;
            display: flex;
            align-items: end;
            gap: 5px;
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
        }

        .bar {
            flex: 1;
            background: linear-gradient(to top, #635bff, #a78bfa);
            border-radius: 5px 5px 0 0;
            opacity: .9;
        }

        .summary-stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 15px;
        }

        .summary-stat {
            padding: 11px;
            background: #f9fafb;
            border-radius: 10px;
        }

            .summary-stat span {
                display: block;
                color: var(--muted);
                font-size: 9px;
            }

            .summary-stat strong {
                display: block;
                margin-top: 3px;
                font-size: 15px;
            }

        /* =========================
                           LOWER GRID
                        ========================= */

        .lower-grid {
            display: grid;
            grid-template-columns: 1.1fr 1fr 1fr;
            gap: 18px;
            margin-top: 18px;
        }

        .panel-body {
            padding: 15px 17px;
        }

        /* =========================
                           TABLE STATUS
                        ========================= */

        .tables-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .restaurant-table {
            padding: 11px 5px;
            border-radius: 9px;
            text-align: center;
            font-size: 9px;
            font-weight: 750;
            border: 1px solid;
        }

        .occupied {
            background: #fef2f2;
            color: #dc2626;
            border-color: #fecaca;
        }

        .available {
            background: #eff6ff;
            color: #2563eb;
            border-color: #bfdbfe;
        }

        .reserved {
            background: #fff7ed;
            color: #ea580c;
            border-color: #fed7aa;
        }

        .table-legend {
            display: flex;
            gap: 14px;
            margin-top: 13px;
            font-size: 9px;
            color: var(--muted);
        }

        .dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            margin-right: 4px;
        }

        /* =========================
                           PAYMENTS
                        ========================= */

        .payment-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #f1f1f1;
        }

        .payment-left {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .payment-icon {
            width: 31px;
            height: 31px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ecfdf5;
            color: #059669;
        }

        .payment-left strong {
            display: block;
            font-size: 10px;
        }

        .payment-left span {
            display: block;
            color: var(--muted);
            font-size: 8px;
            margin-top: 2px;
        }

        .payment-right {
            text-align: right;
        }

            .payment-right strong {
                display: block;
                font-size: 10px;
            }

        .paid {
            color: var(--green);
            font-size: 8px;
        }

        /* =========================
                           ALERTS
                        ========================= */

        .alert-row {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 0;
            border-bottom: 1px solid #f1f1f1;
        }

        .food-image {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .alert-info {
            flex: 1;
        }

            .alert-info strong {
                display: block;
                font-size: 10px;
            }

            .alert-info span {
                display: block;
                color: var(--muted);
                font-size: 8px;
                margin-top: 2px;
            }

        .low-stock {
            padding: 4px 6px;
            background: var(--red-light);
            color: #b91c1c;
            border-radius: 6px;
            font-size: 8px;
            font-weight: 750;
        }

        /* =========================
                           BOTTOM STATS
                        ========================= */

        .bottom-stats {
            margin-top: 18px;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
        }

        .bottom-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 14px;
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .bottom-icon {
            width: 36px;
            height: 36px;
            background: var(--primary-light);
            color: var(--primary);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .bottom-card span {
            color: var(--muted);
            font-size: 9px;
        }

        .bottom-card strong {
            display: block;
            font-size: 16px;
            margin-top: 2px;
        }

        /* =========================
                           RESPONSIVE
                        ========================= */

        @@media (max-width: 1300px) {

            .kpi-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .quick-actions {
                grid-template-columns: repeat(3, 1fr);
            }

            .lower-grid {
                grid-template-columns: 1fr 1fr;
            }

            .bottom-stats {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 1000px) {

            .main-grid {
                grid-template-columns: 1fr;
            }

            .lower-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 700px) {

            .topbar {
                padding: 0 15px;
            }

            .date-box,
            .profile-info {
                display: none;
            }

            .content {
                padding: 18px 14px;
            }

            .kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .quick-actions {
                grid-template-columns: repeat(2, 1fr);
            }

            .bottom-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .orders-table {
                min-width: 850px;
            }

            .card {
                overflow-x: auto;
            }
        }
    </style>
</head>

<body>

    <!-- =========================================================
         MAIN
    ========================================================== -->

    <div class="main">

        <!-- TOPBAR -->

        <header class="topbar">

            <div class="page-title">
                <h1>Dashboard</h1>
                <p>Welcome back! Here's what's happening at your restaurant today.</p>
            </div>

            <div class="top-actions">

                <div class="date-box">
                    📅
                    <span id="todayDate">Today</span>
                </div>

                <button class="notification">
                    🔔
                    <span></span>
                </button>

                <div class="profile">

                    @* <div class="profile-avatar">
                        @ViewBag.RestaurantName.Substring(0, 1).ToUpper()
                    </div> *@

                    <div class="profile-info">
                        <strong>@ViewBag.RestaurantName</strong>
                        <span>Restaurant Admin</span>
                    </div>

                </div>

            </div>

        </header>


        <!-- CONTENT -->

        <main class="content">


            <!-- =================================================
                 TOP KPI CARDS
            ================================================== -->

            <div class="kpi-grid">

                <div class="kpi-card"
                     onclick="showMessage('Opening Live Orders...')">

                    <div class="kpi-top">
                        <div class="kpi-icon icon-red">🔴</div>
                        <span>→</span>
                    </div>

                    <div class="kpi-label">
                        Live Orders
                    </div>

                    <div class="kpi-value">
                        12
                    </div>

                    <div class="kpi-footer">
                        <span class="positive">8 preparing</span>
                        <span class="muted">View orders</span>
                    </div>

                </div>


                <div class="kpi-card">

                    <div class="kpi-top">
                        <div class="kpi-icon icon-blue">📋</div>
                        <span>→</span>
                    </div>

                    <div class="kpi-label">
                        Today's Orders
                    </div>

                    <div class="kpi-value">
                        86
                    </div>

                    <div class="kpi-footer">
                        <span class="positive">+8.2%</span>
                        <span class="muted">vs yesterday</span>
                    </div>

                </div>


                <div class="kpi-card">

                    <div class="kpi-top">
                        <div class="kpi-icon icon-purple">🌐</div>
                        <span>→</span>
                    </div>

                    <div class="kpi-label">
                        Online Orders
                    </div>

                    <div class="kpi-value">
                        34
                    </div>

                    <div class="kpi-footer">
                        <span class="positive">39.5%</span>
                        <span class="muted">of today's orders</span>
                    </div>

                </div>


                <div class="kpi-card">

                    <div class="kpi-top">
                        <div class="kpi-icon icon-orange">🪑</div>
                        <span>→</span>
                    </div>

                    <div class="kpi-label">
                        Table Bookings
                    </div>

                    <div class="kpi-value">
                        18
                    </div>

                    <div class="kpi-footer">
                        <span class="positive">6 upcoming</span>
                        <span class="muted">today</span>
                    </div>

                </div>


                <div class="kpi-card">

                    <div class="kpi-top">
                        <div class="kpi-icon icon-green">₹</div>
                        <span>→</span>
                    </div>

                    <div class="kpi-label">
                        Today's Revenue
                    </div>

                    <div class="kpi-value">
                        ₹24,680
                    </div>

                    <div class="kpi-footer">
                        <span class="positive">+12.5%</span>
                        <span class="muted">vs yesterday</span>
                    </div>

                </div>

            </div>


            <!-- =================================================
                 QUICK ACTIONS
            ================================================== -->

            <div class="section-label">
                Quick Access
            </div>

            <div class="quick-actions">

                <div class="quick-card"
                     onclick="showMessage('Opening Live Orders...')">

                    <div class="quick-icon">🔴</div>

                    <div class="quick-text">
                        <strong>Live Orders</strong>
                        <span>12 active orders</span>
                    </div>

                </div>


                <div class="quick-card">

                    <div class="quick-icon">📋</div>

                    <div class="quick-text">
                        <strong>Today's Orders</strong>
                        <span>86 total orders</span>
                    </div>

                </div>


                <div class="quick-card">

                    <div class="quick-icon">🌐</div>

                    <div class="quick-text">
                        <strong>Online Orders</strong>
                        <span>34 online orders</span>
                    </div>

                </div>


                <div class="quick-card">

                    <div class="quick-icon">🪑</div>

                    <div class="quick-text">
                        <strong>Table Bookings</strong>
                        <span>18 bookings</span>
                    </div>

                </div>


                <div class="quick-card">

                    <div class="quick-icon">💳</div>

                    <div class="quick-text">
                        <strong>Payments</strong>
                        <span>₹24,680 collected</span>
                    </div>

                </div>


                <div class="quick-card">

                    <div class="quick-icon">🍴</div>

                    <div class="quick-text">
                        <strong>Menu</strong>
                        <span>128 active items</span>
                    </div>

                </div>

            </div>


            <!-- =================================================
                 MAIN DASHBOARD
            ================================================== -->

            <div class="main-grid">


                <!-- LIVE ORDERS -->

                <section class="card">

                    <div class="card-header">

                        <div>
                            <h3>🔴 Live Orders</h3>
                            <p>Orders that currently need your attention</p>
                        </div>

                        <a href="#" class="view-link">
                            View All →
                        </a>

                    </div>


                    <div style="overflow-x:auto;">

                        <table class="orders-table">

                            <thead>

                                <tr>
                                    <th>Order ID</th>
                                    <th>Type</th>
                                    <th>Customer</th>
                                    <th>Table No.</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Time</th>
                                    <th>Action</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>

                                    <td>
                                        <span class="order-id">#ORD-1025</span>
                                    </td>

                                    <td>
                                        <span class="type-badge type-dine">
                                            Dine In
                                        </span>
                                    </td>

                                    <td>
                                        <span class="customer">
                                            Rahul Sharma
                                        </span>
                                    </td>

                                    <td>
                                        <span class="table-number">
                                            T-05
                                        </span>
                                    </td>

                                    <td>
                                        ₹850
                                    </td>

                                    <td>
                                        <span class="status-badge status-preparing">
                                            Preparing
                                        </span>
                                    </td>

                                    <td>
                                        5 min ago
                                    </td>

                                    <td>

                                        <div class="order-actions">

                                            <button class="small-btn primary"
                                                    onclick="showMessage('Order #ORD-1025 opened')">
                                                View
                                            </button>

                                            <button class="small-btn">
                                                ✓
                                            </button>

                                        </div>

                                    </td>

                                </tr>


                                <tr>

                                    <td>
                                        <span class="order-id">#ORD-1024</span>
