@{
    ViewData["Title"] = "Restaurant QR Code";
    Layout = "~/Areas/Restaurant/Views/Shared/_LayoutResto.cshtml";

    var qrCodePath = TempData["QRCodePath"] as string;
}

<div class="container-fluid">

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h3 class="mb-1">Restaurant QR Code</h3>

                    <p class="text-muted mb-0">
                        Generate a QR code for your restaurant menu.
                    </p>
                </div>

                <span class="badge bg-primary p-2">
                    QR MENU
                </span>

            </div>

       
            @if (!string.IsNullOrEmpty(qrCodePath))
            {
                <div class="text-center">

                    <div class="mb-4">

                        <img src="@qrCodePath"
                             alt="Restaurant QR Code"
                             class="img-fluid"
                             style="max-width:300px;" />

                    </div>

                    <a href="@qrCodePath"
                       download
                       class="btn btn-success">

                        ⬇ Download QR Code

                    </a>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div style="font-size:70px;">
                        📱
                    </div>

                    <h4 class="mt-3">
                        Generate Your Restaurant QR Code
                    </h4>

                    <p class="text-muted">
                        Customers can scan this QR code to view your restaurant menu.
                    </p>

                    <form method="post"
                          action="@Url.Action("Generate", "QRCode", new { area = "Restaurant" })">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-primary px-4 py-2">
                            Generate QR Code
                        </button>

                    </form>

                </div>
            }

        </div>

    </div>

</div>