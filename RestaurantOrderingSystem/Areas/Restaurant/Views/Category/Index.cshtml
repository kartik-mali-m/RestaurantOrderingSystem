@model List<RestaurantOrderingSystem.Models.Menu.Category>

@{
   
    Layout = "~/Areas/Restaurant/Views/Shared/_LayoutResto.cshtml";

    ViewData["Title"] = "Categories";

    var totalCategories = Model.Count;
    var activeCategories = Model.Count(x => x.IsActive);
    var inactiveCategories = Model.Count(x => !x.IsActive);
}

<style>
    /* =========================================================
           CATEGORY PAGE
           ========================================================= */

    .category-page {
        min-height: calc(100vh - 70px);
        background: #f6f7f9;
        padding: 30px;
    }

    .category-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .category-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
    }

    .category-title h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 750;
        color: #202328;
    }

    .category-title p {
        margin: 7px 0 0;
        color: #777d86;
        font-size: 14px;
    }

    .header-actions {
        display: flex;
        gap: 10px;
    }

    .category-btn {
        height: 43px;
        padding: 0 16px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 650;
        transition: .2s ease;
    }

    .category-btn-primary {
        background: #ff6b35;
        border: 1px solid #ff6b35;
        color: #fff;
    }

        .category-btn-primary:hover {
            background: #e85a28;
            border-color: #e85a28;
            color: #fff;
        }

    .category-btn-secondary {
        background: #fff;
        border: 1px solid #dfe3e7;
        color: #454a51;
    }

        .category-btn-secondary:hover {
            background: #f1f2f4;
            color: #25282d;
        }

    /* =========================================================
           SUMMARY CARDS
           ========================================================= */

    .category-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #e4e7eb;
        border-radius: 13px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .summary-icon {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        background: #f1f2f4;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .summary-text span {
        display: block;
        font-size: 12px;
        color: #7d838b;
        margin-bottom: 4px;
    }

    .summary-text strong {
        font-size: 22px;
        color: #202328;
    }

    /* =========================================================
           TOOLBAR
           ========================================================= */

    .category-toolbar {
        background: #fff;
        border: 1px solid #e4e7eb;
        border-radius: 13px;
        padding: 14px;
        margin-bottom: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .search-box {
        position: relative;
        width: 330px;
    }

        .search-box input {
            width: 100%;
            height: 42px;
            border: 1px solid #dfe3e7;
            border-radius: 8px;
            padding: 0 14px 0 39px;
            outline: none;
            font-size: 13px;
            color: #30343a;
        }

            .search-box input:focus {
                border-color: #ff6b35;
                box-shadow: 0 0 0 3px rgba(255,107,53,.09);
            }

    .search-icon {
        position: absolute;
        left: 13px;
        top: 11px;
        font-size: 14px;
        color: #858b93;
    }

    .category-filter {
        display: flex;
        gap: 7px;
    }

    .filter-button {
        height: 37px;
        padding: 0 13px;
        border-radius: 8px;
        border: 1px solid #dfe3e7;
        background: #fff;
        color: #656b73;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }

        .filter-button.active {
            background: #202328;
            color: #fff;
            border-color: #202328;
        }

    /* =========================================================
           CATEGORY LIST
           ========================================================= */

    .category-list {
        background: #fff;
        border: 1px solid #e4e7eb;
        border-radius: 13px;
        overflow: hidden;
    }

    .category-list-header {
        padding: 17px 20px;
        border-bottom: 1px solid #edf0f2;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .category-list-header h3 {
            margin: 0;
            font-size: 15px;
            color: #292d33;
            font-weight: 700;
        }

        .category-list-header span {
            color: #858b93;
            font-size: 12px;
        }

    /* =========================================================
           CATEGORY CARD
           ========================================================= */

    .category-row {
        display: grid;
        grid-template-columns: 55px minmax(150px, 1fr) minmax(250px, 2fr) 120px 150px;
        align-items: center;
        gap: 15px;
        padding: 16px 20px;
        border-bottom: 1px solid #f0f1f3;
        transition: .15s ease;
    }

        .category-row:last-child {
            border-bottom: none;
        }

        .category-row:hover {
            background: #fafbfc;
        }

    .category-number {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: #fff0e9;
        color: #ff6b35;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
    }

    .category-name {
        font-size: 14px;
        font-weight: 700;
        color: #292d33;
    }

    .category-description {
        font-size: 13px;
        color: #777d85;
        line-height: 1.4;
    }

        .category-description.empty {
            color: #a0a5ac;
            font-style: italic;
        }

    /* =========================================================
           STATUS
           ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 650;
    }

    .status-active {
        background: #e9f8ef;
        color: #198754;
    }

    .status-inactive {
        background: #f0f1f3;
        color: #727780;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    /* =========================================================
           ACTIONS
           ========================================================= */

    .category-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 7px;
    }

    .action-button {
        height: 34px;
        padding: 0 10px;
        border-radius: 7px;
        border: 1px solid #dfe3e7;
        background: #fff;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .edit-action {
        color: #2563eb;
    }

        .edit-action:hover {
            background: #eff5ff;
            border-color: #cbdcff;
            color: #1d4ed8;
        }

    .deactivate-action {
        color: #dc3545;
    }

        .deactivate-action:hover {
            background: #fff0f1;
            border-color: #f3c6ca;
            color: #c82333;
        }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .empty-category {
        background: #fff;
        border: 1px dashed #d3d7dc;
        border-radius: 13px;
        padding: 70px 25px;
        text-align: center;
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        border-radius: 16px;
        background: #fff0e9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 31px;
        margin: 0 auto 17px;
    }

    .empty-category h3 {
        margin: 0 0 7px;
        color: #30343a;
        font-size: 18px;
    }

    .empty-category p {
        margin: 0 auto 20px;
        color: #81878f;
        font-size: 13px;
        max-width: 430px;
        line-height: 1.5;
    }

    /* =========================================================
           SUCCESS ALERT
           ========================================================= */

    .success-message {
        background: #eaf8ef;
        border: 1px solid #c9ead6;
        color: #176b42;
        border-radius: 9px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1000px) {

        .category-row {
            grid-template-columns: 45px 1fr 120px 140px;
        }

        .category-description {
            display: none;
        }
    }

    @@media (max-width: 750px) {

        .category-page {
            padding: 18px;
        }

        .category-header {
            flex-direction: column;
        }

        .header-actions {
            width: 100%;
        }

            .header-actions .category-btn {
                flex: 1;
            }

        .category-summary {
            grid-template-columns: 1fr;
        }

        .category-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            width: 100%;
        }

        .category-filter {
            width: 100%;
        }

        .filter-button {
            flex: 1;
        }

        .category-row {
            grid-template-columns: 45px 1fr;
            gap: 12px;
        }

            .category-row > :nth-child(3),
            .category-row > :nth-child(4) {
                grid-column: 2;
            }

        .category-actions {
            justify-content: flex-start;
        }
    }
</style>


<div class="category-page">

    <div class="category-container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="category-header">

            <div class="category-title">

                <h1>Categories</h1>

                <p>
                    Organize your menu items into easy-to-find categories.
                </p>

            </div>

            <div class="header-actions">

                <a href="/Restaurant/Menu/Index"
                   class="category-btn category-btn-secondary">

                    🍴
                    Menu Management

                </a>

                <a href="/Restaurant/Category/Create"
                   class="category-btn category-btn-primary">

                    ＋
                    Add Category

                </a>
            </div>

        </div>


        <!-- =====================================================
             SUCCESS MESSAGE
             ===================================================== -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">

                ✓
                @TempData["SuccessMessage"]

            </div>
        }


        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <div class="category-summary">

            <div class="summary-card">

                <div class="summary-icon">
                    🏷️
                </div>

                <div class="summary-text">

                    <span>Total Categories</span>

                    <strong>
                        @totalCategories
                    </strong>

                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon">
                    ✓
                </div>

                <div class="summary-text">

                    <span>Active Categories</span>

                    <strong>
                        @activeCategories
                    </strong>

                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon">
                    ○
                </div>

                <div class="summary-text">

                    <span>Inactive Categories</span>

                    <strong>
                        @inactiveCategories
                    </strong>

                </div>

            </div>

        </div>


        <!-- =====================================================
             SEARCH + FILTER
             ===================================================== -->
        @if (Model.Any())
        {
            <div class="category-toolbar">

                <div class="search-box">

                    <span class="search-icon">
                        🔍
                    </span>

                    <input type="text"
                           id="categorySearch"
                           placeholder="Search categories..." />

                </div>


                <div class="category-filter">

                    <button type="button"
                            class="filter-button active"
                            data-filter="all">

                        All

                    </button>

                    <button type="button"
                            class="filter-button"
                            data-filter="active">

                        Active

                    </button>

                    <button type="button"
                            class="filter-button"
                            data-filter="inactive">

                        Inactive

                    </button>

                </div>

            </div>
        }


        <!-- =====================================================
             CATEGORY LIST
             ===================================================== -->
        @if (!Model.Any())
        {
            <div class="empty-category">

                <div class="empty-icon">
                    🏷️
                </div>

                <h3>
                    No categories yet
                </h3>

                <p>
                    Categories help customers quickly find the food
                    they are looking for. Create your first category
                    to start building your menu.
                </p>

                <a asp-area="Restaurant"
                   asp-controller="Category"
                   asp-action="Create"
                   class="category-btn category-btn-primary">

                    ＋ Create First Category

                </a>

            </div>
        }
        else
        {
            <div class="category-list">

                <div class="category-list-header">

                    <h3>
                        Menu Categories
                    </h3>

                    <span>
                        @totalCategories categories
                    </span>

                </div>


                <div id="categoryList">

                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var category = Model[i];

                        <div class="category-row"
                             data-name="@category.Name.ToLower()"
                             data-status="@(category.IsActive ? "active" : "inactive")">

                            <!-- NUMBER -->

                            <div class="category-number">

                                @(i + 1)

                            </div>


                            <!-- NAME -->

                            <div class="category-name">

                                @category.Name

                            </div>


                            <!-- DESCRIPTION -->
                            @if (!string.IsNullOrWhiteSpace(category.Description))
                            {
                                <div class="category-description">

                                    @category.Description

                                </div>
                            }
                            else
                            {
                                <div class="category-description empty">

                                    No description added

                                </div>
                            }


                            <!-- STATUS -->

                            <div>

                                @if (category.IsActive)
                                {
                                    <span class="status-badge status-active">

                                        <span class="status-dot"></span>

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">

                                        <span class="status-dot"></span>

                                        Inactive

                                    </span>
                                }

                            </div>


                            <!-- ACTIONS -->

                            <div class="category-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@category.Id"
                                   class="action-button edit-action">

                                    ✏️ Edit

                                </a>


                                @if (category.IsActive)
                                {
                                    <form asp-action="Delete"
                                          asp-route-id="@category.Id"
                                          method="post"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="action-button deactivate-action"
                                                onclick="return confirm('Are you sure you want to deactivate this category?');">

                                            ⛔

                                        </button>

                                    </form>
                                }

                            </div>

                        </div>
                    }

                </div>

            </div>
        }

    </div>

</div>


<script>

    const searchInput =
        document.getElementById("categorySearch");

    const categoryRows =
        document.querySelectorAll(".category-row");

    const filterButtons =
        document.querySelectorAll(".filter-button");


    let currentFilter = "all";


    function filterCategories() {

        if (!searchInput) {
            return;
        }


        const searchText =
            searchInput.value
                .toLowerCase()
                .trim();


        categoryRows.forEach(row => {

            const name =
                row.dataset.name || "";

            const status =
                row.dataset.status || "";


            const matchesSearch =
                name.includes(searchText);


            const matchesFilter =
                currentFilter === "all"
                || currentFilter === status;


            row.style.display =
                matchesSearch && matchesFilter
                    ? "grid"
                    : "none";

        });

    }


    if (searchInput) {

        searchInput.addEventListener(
            "input",
            filterCategories
        );

    }


    filterButtons.forEach(button => {

        button.addEventListener(
            "click",
            function () {

                filterButtons.forEach(btn => {
                    btn.classList.remove("active");
                });


                this.classList.add("active");


                currentFilter =
                    this.dataset.filter;


                filterCategories();

            }
        );

    });

</script>