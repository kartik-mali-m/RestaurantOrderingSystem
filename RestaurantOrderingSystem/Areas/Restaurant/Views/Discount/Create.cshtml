@model RestaurantOrderingSystem.ViewModels.Offer.DiscountVM

@{
    ViewData["Title"] = "Create Discount";
    Layout = "~/Areas/Restaurant/Views/Shared/_LayoutResto.cshtml";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h3 class="mb-4">
                        Create Discount
                    </h3>

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- MENU ITEM -->

                        <div class="mb-3">

                            <label asp-for="MenuItemId"
                                   class="form-label">
                                Select Menu Item
                            </label>

                            <select asp-for="MenuItemId"
                                    asp-items="ViewBag.MenuItems"
                                    class="form-select">

                                <option value="">
                                    -- Select Menu Item --
                                </option>

                            </select>

                            <span asp-validation-for="MenuItemId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- NAME -->

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                Discount Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Example: Special Discount" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PERCENTAGE -->

                        <div class="mb-3">

                            <label asp-for="DiscountPercentage"
                                   class="form-label">
                                Discount Percentage
                            </label>

                            <input asp-for="DiscountPercentage"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   max="100"
                                   class="form-control"
                                   placeholder="Example: 10" />

                            <span asp-validation-for="DiscountPercentage"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ACTIVE -->

                        <div class="form-check mb-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active
                            </label>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success">
                                Create Discount
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}