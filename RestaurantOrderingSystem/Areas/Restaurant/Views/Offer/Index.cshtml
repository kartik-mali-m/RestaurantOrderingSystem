@model List<RestaurantOrderingSystem.Models.Offer.Offer>

@{
    ViewData["Title"] = "Offers";
    Layout = "~/Areas/Restaurant/Views/Shared/_LayoutResto.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Offers</h2>
            <p class="text-muted mb-0">
                Manage special offers for your restaurant.
            </p>
        </div>

        <a asp-area="Restaurant"
           asp-controller="Offer"
           asp-action="Create"
           class="btn btn-success">
            + Create Offer
        </a>
        @* <a href="/Restaurant/Offer/Create" class="btn btn-success">
            + Create Offer
        </a> *@
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Target</th>
                        <th>Discount</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        var isCurrentlyActive =
                        item.IsActive &&
                        item.StartDate <= DateTime.Now &&
                        item.EndDate >= DateTime.Now;

                        <tr>

                            <td>
                                <strong>@item.Name</strong>

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <br />
                                    <small class="text-muted">
                                        @item.Description
                                    </small>
                                }
                            </td>

                            <td>

                                @if (item.TargetType ==
                                                        RestaurantOrderingSystem.Models.Offer.OfferTargetType.Restaurant)
                                {
                                    <span class="badge bg-primary">
                                        Entire Restaurant
                                    </span>
                                }
                                else if (item.TargetType ==
                                RestaurantOrderingSystem.Models.Offer.OfferTargetType.Category)
                                {
                                    <span class="badge bg-info">
                                        Category
                                    </span>

                                    <br />

                                    <small>
                                        @item.Category?.Name
                                    </small>
                                }
                                else if (item.TargetType ==
                                RestaurantOrderingSystem.Models.Offer.OfferTargetType.MenuItem)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Menu Item
                                    </span>

                                    <br />

                                    <small>
                                        @item.MenuItem?.Name
                                    </small>
                                }

                            </td>

                            <td>
                                <strong>
                                    @item.DiscountPercentage%
                                </strong>
                            </td>

                            <td>
                                @item.StartDate.ToString("dd MMM yyyy hh:mm tt")
                            </td>

                            <td>
                                @item.EndDate.ToString("dd MMM yyyy hh:mm tt")
                            </td>

                            <td>

                                @if (isCurrentlyActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else if (!item.IsActive)
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }
                                else if (item.StartDate > DateTime.Now)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Upcoming
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Expired
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <a asp-area="Restaurant"
                                   asp-controller="Offer"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-primary">
                                    Edit
                                </a>

                                @if (item.IsActive)
                                {
                                    <form asp-area="Restaurant"
                                          asp-controller="Offer"
                                          asp-action="Delete"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to deactivate this offer?');">
                                            Deactivate
                                        </button>

                                    </form>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info text-center">

            <h5>No offers found.</h5>

            <p class="mb-0">
                Create your first offer for customers.
            </p>

        </div>
    }

</div>