@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-page">

    <!-- WELCOME -->
    <div class="dashboard-welcome">
        <div>
            <div class="welcome-label">
                ADMINISTRATION CENTER
            </div>
            <h1>
                Welcome back, Super Admin 👋
            </h1>
            <p>
                Manage restaurants, users, approvals and system operations from one place.
            </p>
        </div>

        <div class="welcome-actions">
            <a asp-area="Admin"
               asp-controller="Restaurant"
               asp-action="Pending"
               class="dashboard-primary-button">
                Review Restaurants
            </a>
        </div>
    </div>

    <!-- STATISTICS -->
    <div class="dashboard-stat-grid">
        <div class="dashboard-stat-card">
            <div class="stat-icon purple">
                R
            </div>
            <div class="stat-content">
                <span class="stat-label">
                    Total Restaurants
                </span>
                <strong class="stat-number">
                    1
                </strong>
                <span class="stat-description">
                    Registered restaurants
                </span>
            </div>
        </div>

        <div class="dashboard-stat-card">
            <div class="stat-icon orange">
                P
            </div>
            <div class="stat-content">
                <span class="stat-label">
                    Pending Approvals
                </span>
                <strong class="stat-number">
                    1
                </strong>
                <span class="stat-description">
                    Requires your attention
                </span>
            </div>
        </div>

        <div class="dashboard-stat-card">
            <div class="stat-icon green">
                U
            </div>
            <div class="stat-content">
                <span class="stat-label">
                    Total Users
                </span>
                <strong class="stat-number">
                    2
                </strong>
                <span class="stat-description">
                    Registered system users
                </span>
            </div>
        </div>

        <div class="dashboard-stat-card">
            <div class="stat-icon blue">
                ✓
            </div>
            <div class="stat-content">
                <span class="stat-label">
                    System Status
                </span>
                <strong class="stat-number status-online">
                    Online
                </strong>
                <span class="stat-description">
                    All services operational
                </span>
            </div>
        </div>
    </div>

    <!-- MAIN GRID -->
    <div class="dashboard-main-grid">

        <!-- QUICK ACTIONS -->
        <div class="dashboard-panel">
            <div class="panel-header">
                <div>
                    <h3>
                        Quick Actions
                    </h3>
                    <p>
                        Frequently used administration tools
                    </p>
                </div>
            </div>

            <div class="quick-action-grid">
                <a asp-area="Admin"
                   asp-controller="Restaurant"
                   asp-action="Pending"
                   class="quick-action">
                    <div class="quick-action-icon purple">
                        R
                    </div>
                    <div>
                        <strong>
                            Manage Restaurants
                        </strong>
                        <span>
                            Review and approve restaurants
                        </span>
                    </div>
                    <span class="action-arrow">
                        →
                    </span>
                </a>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   class="quick-action">
                    <div class="quick-action-icon green">
                        U
                    </div>
                    <div>
                        <strong>
                            Manage Users
                        </strong>
                        <span>
                            View and manage system users
                        </span>
                    </div>
                    <span class="action-arrow">
                        →
                    </span>
                </a>

                <a asp-area="Admin"
                   asp-controller="Reports"
                   asp-action="Index"
                   class="quick-action">
                    <div class="quick-action-icon blue">
                        A
                    </div>
                    <div>
                        <strong>
                            Analytics & Reports
                        </strong>
                        <span>
                            View system performance
                        </span>
                    </div>
                    <span class="action-arrow">
                        →
                    </span>
                </a>

                <a href="#" class="quick-action">
                    <div class="quick-action-icon orange">
                        S
                    </div>
                    <div>
                        <strong>
                            System Settings
                        </strong>
                        <span>
                            Configure application settings
                        </span>
                    </div>
                    <span class="action-arrow">
                        →
                    </span>
                </a>
            </div>
        </div>

        <!-- ATTENTION PANEL -->
        <div class="dashboard-panel">
            <div class="panel-header">
                <div>
                    <h3>
                        Needs Attention
                    </h3>
                    <p>
                        Items requiring action
                    </p>
                </div>
            </div>

            <div class="attention-item">
                <div class="attention-icon">
                    !
                </div>
                <div class="attention-content">
                    <strong>
                        Restaurant approval
                    </strong>
                    <span>
                        1 restaurant is waiting for approval.
                    </span>
                </div>
                <a asp-area="Admin"
                   asp-controller="Restaurant"
                   asp-action="Pending"
                   class="attention-link">
                    Review
                </a>
            </div>

            <div class="attention-item">
                <div class="attention-icon blue">
                    i
                </div>
                <div class="attention-content">
                    <strong>
                        System overview
                    </strong>
                    <span>
                        Check reports and system activity.
                    </span>
                </div>
                <a asp-area="Admin"
                   asp-controller="Reports"
                   asp-action="Index"
                   class="attention-link">
                    View
                </a>
            </div>
        </div>
    </div>

    <!-- SYSTEM OVERVIEW -->
    <div class="dashboard-panel system-overview">
        <div class="panel-header">
            <div>
                <h3>
                    Platform Overview
                </h3>
                <p>
                    Restaurant Ordering System administration
                </p>
            </div>
            <span class="system-badge">
                SYSTEM ONLINE
            </span>
        </div>

        <div class="overview-grid">
            <div class="overview-item">
                <span class="overview-number">
                    1
                </span>
                <span class="overview-label">
                    Restaurants
                </span>
            </div>

            <div class="overview-item">
                <span class="overview-number">
                    2
                </span>
                <span class="overview-label">
                    Users
                </span>
            </div>

            <div class="overview-item">
                <span class="overview-number">
                    1
                </span>
                <span class="overview-label">
                    Pending
                </span>
            </div>

            <div class="overview-item">
                <span class="overview-number">
                    0
                </span>
                <span class="overview-label">
                    Reports
                </span>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-page {
        max-width: 1500px;
        margin: auto;
    }

    /* WELCOME */
    .dashboard-welcome {
        background: linear-gradient( 120deg, #111827 0%, #312e81 55%, #635bff 100% );
        border-radius: 20px;
        padding: 34px 38px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        box-shadow: 0 15px 40px rgba(17, 24, 39, 0.15);
    }

    .welcome-label {
        font-size: 10px;
        letter-spacing: 2px;
        font-weight: 700;
        opacity: 0.7;
        margin-bottom: 8px;
    }

    .dashboard-welcome h1 {
        font-size: 28px;
        font-weight: 750;
        margin: 0 0 8px;
    }

    .dashboard-welcome p {
        margin: 0;
        color: #d1d5db;
        font-size: 13px;
    }

    .dashboard-primary-button {
        background: white;
        color: #312e81;
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        transition: 0.2s;
    }

        .dashboard-primary-button:hover {
            color: #312e81;
            transform: translateY(-2px);
        }

    /* STATISTICS */
    .dashboard-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .dashboard-stat-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 15px;
        transition: 0.2s;
    }

        .dashboard-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.06);
        }

    .stat-icon {
        min-width: 50px;
        height: 50px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        font-weight: 800;
    }

    .purple {
        background: #ede9fe;
        color: #6d28d9;
    }

    .orange {
        background: #ffedd5;
        color: #c2410c;
    }

    .green {
        background: #dcfce7;
        color: #15803d;
    }

    .blue {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        font-size: 11px;
        color: #6b7280;
    }

    .stat-number {
        font-size: 22px;
        margin-top: 2px;
        line-height: 1.3;
    }

    .stat-description {
        font-size: 10px;
        color: #9ca3af;
    }

    .status-online {
        color: #16a34a;
    }

    /* MAIN GRID */
    .dashboard-main-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    .dashboard-panel {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        overflow: hidden;
    }

    .panel-header {
        padding: 20px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #f0f0f0;
    }

        .panel-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
        }

        .panel-header p {
            margin: 4px 0 0;
            color: #9ca3af;
            font-size: 11px;
        }

    /* QUICK ACTIONS */
    .quick-action-grid {
        padding: 15px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .quick-action {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px;
        border: 1px solid #edf0f4;
        border-radius: 12px;
        text-decoration: none;
        color: #1f2937;
        transition: 0.2s;
    }

        .quick-action:hover {
            border-color: #c7d2fe;
            background: #fafaff;
            color: #1f2937;
            transform: translateY(-2px);
        }

    .quick-action-icon {
        min-width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 800;
    }

    .quick-action strong {
        display: block;
        font-size: 12px;
    }

    .quick-action span:not(.action-arrow) {
        display: block;
        font-size: 10px;
        color: #9ca3af;
        margin-top: 3px;
    }

    .action-arrow {
        margin-left: auto;
        color: #9ca3af;
    }

    /* ATTENTION */
    .attention-item {
        padding: 17px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid #f0f0f0;
    }

        .attention-item:last-child {
            border-bottom: 0;
        }

    .attention-icon {
        width: 36px;
        height: 36px;
        min-width: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fef3c7;
        color: #b45309;
        font-weight: 800;
    }

    .attention-content {
        flex: 1;
    }

        .attention-content strong {
            display: block;
            font-size: 12px;
        }

        .attention-content span {
            display: block;
            color: #9ca3af;
            font-size: 10px;
            margin-top: 3px;
        }

    .attention-link {
        color: #635bff;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
    }

    /* OVERVIEW */
    .system-overview {
        margin-bottom: 10px;
    }

    .system-badge {
        background: #dcfce7;
        color: #15803d;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
    }

    .overview-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .overview-item {
        padding: 25px;
        text-align: center;
        border-right: 1px solid #f0f0f0;
    }

        .overview-item:last-child {
            border-right: 0;
        }

    .overview-number {
        display: block;
        font-size: 25px;
        font-weight: 750;
    }

    .overview-label {
        color: #9ca3af;
        font-size: 10px;
    }

    /* RESPONSIVE */
    @@media (max-width: 1100px) {
        .dashboard-stat-grid

    {
        grid-template-columns: 1fr 1fr;
    }

    .dashboard-main-grid {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 700px) {
        .dashboard-welcome

    {
        padding: 25px;
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
    }

    .dashboard-welcome h1 {
        font-size: 22px;
    }

    .dashboard-stat-grid {
        grid-template-columns: 1fr;
    }

    .quick-action-grid {
        grid-template-columns: 1fr;
    }

    .overview-grid {
        grid-template-columns: 1fr 1fr;
    }

    .overview-item:nth-child(2) {
        border-right: 0;
    }

    .overview-item {
        border-bottom: 1px solid #f0f0f0;
    }

    }
</style>