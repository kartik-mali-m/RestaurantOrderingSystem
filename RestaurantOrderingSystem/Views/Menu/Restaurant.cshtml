@model RestaurantOrderingSystem.ViewModels.Customer.RestaurantMenuVM

@{
    ViewData["Title"] = Model.RestaurantName + " Menu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --menu-accent: #C0392B;
        --menu-accent-dark: #922B21;
        --menu-cream: #FFF8F0;
        --menu-ink: #2B2119;
        --menu-muted: #8A7B6E;
    }

    body {
        background-color: var(--menu-cream);
    }

    /* ---------- Header ---------- */
    .menu-hero {
        background: linear-gradient(135deg, var(--menu-accent), var(--menu-accent-dark));
        color: #fff;
        border-radius: 0 0 24px 24px;
        padding: 32px 16px 28px;
        text-align: center;
        margin: -1.5rem -0.75rem 1.5rem;
    }

        .menu-hero img,
        .menu-hero .menu-hero-emoji {
            width: 84px;
            height: 84px;
            border-radius: 50%;
            object-fit: cover;
            background: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.2);
            margin-bottom: 12px;
        }

        .menu-hero h1 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .menu-hero p {
            font-size: 0.9rem;
            opacity: 0.92;
            margin-bottom: 2px;
        }

    /* ---------- Sticky category nav ---------- */
    .category-nav {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--menu-cream);
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding: 10px 4px;
        margin-bottom: 1.25rem;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        border-bottom: 1px solid rgba(0,0,0,0.06);
    }

        .category-nav::-webkit-scrollbar {
            display: none;
        }

    .category-pill {
        flex: 0 0 auto;
        padding: 6px 16px;
        border-radius: 999px;
        background: #fff;
        color: var(--menu-ink);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid rgba(0,0,0,0.08);
        white-space: nowrap;
    }

        .category-pill:hover {
            background: var(--menu-accent);
            color: #fff;
        }

    /* ---------- Category section ---------- */
    .menu-category {
        margin-bottom: 2.25rem;
        scroll-margin-top: 60px;
    }

        .menu-category h2 {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--menu-ink);
            margin-bottom: 2px;
        }

        .menu-category .category-desc {
            color: var(--menu-muted);
            font-size: 0.85rem;
            margin-bottom: 0;
        }

    .menu-category-divider {
        height: 3px;
        width: 40px;
        background: var(--menu-accent);
        border-radius: 3px;
        margin: 6px 0 14px;
    }

    /* ---------- Item card ---------- */
    .menu-item-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 2px 8px rgba(43,33,25,0.06);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .menu-item-img {
        width: 100%;
        height: 160px;
        object-fit: cover;
    }

    .menu-item-img-placeholder {
        width: 100%;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        background: #F3E9DD;
    }

    .menu-item-body {
        padding: 14px 14px 12px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .menu-item-name {
        font-size: 1rem;
        font-weight: 700;
        color: var(--menu-ink);
        margin-bottom: 4px;
    }

    .menu-item-desc {
        font-size: 0.82rem;
        color: var(--menu-muted);
        margin-bottom: 10px;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .menu-item-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: auto;
    }

    .menu-item-price {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--menu-ink);
        white-space: nowrap;
    }

    .btn-add-cart {
        background: var(--menu-accent);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 8px 14px;
        font-size: 0.85rem;
        font-weight: 600;
        white-space: nowrap;
        transition: background 0.15s ease;
    }

        .btn-add-cart:hover,
        .btn-add-cart:active {
            background: var(--menu-accent-dark);
            color: #fff;
        }

    /* ---------- Empty state ---------- */
    .menu-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--menu-muted);
    }

        .menu-empty .menu-empty-emoji {
            font-size: 60px;
            margin-bottom: 12px;
        }

    /* ---------- Mobile tightening ---------- */
    @@media (max-width: 575.98px) {
        .menu-hero {
            border-radius: 0 0 18px 18px;
            padding: 26px 12px 22px;
        }

        .menu-item-img,
        .menu-item-img-placeholder {
            height: 140px;
        }
    }
</style>

<div class="container py-3">

    <!-- Restaurant Header -->
    <div class="menu-hero">
        @if (!string.IsNullOrEmpty(Model.RestaurantLogo))
        {
            <img src="@Model.RestaurantLogo" alt="@Model.RestaurantName" />
        }
        else
        {
            <div class="menu-hero-emoji">🍽️</div>
        }

        <h1>@Model.RestaurantName</h1>

        @if (!string.IsNullOrEmpty(Model.Address))
        {
            <p>📍 @Model.Address</p>
        }

        @if (!string.IsNullOrEmpty(Model.Phone))
        {
            <p>📞 @Model.Phone</p>
        }
    </div>

    @if (Model.Categories.Any())
    {
        <!-- Sticky category quick-nav -->
        <div class="category-nav">
            @foreach (var category in Model.Categories)
            {
                <a class="category-pill" href="#cat-@category.CategoryName.Replace(" ", "-")">
                    @category.CategoryName
                </a>
            }
        </div>

        foreach (var category in Model.Categories)
        {
            <div class="menu-category" id="cat-@category.CategoryName.Replace(" ", "-")">

                <h2>@category.CategoryName</h2>

                @if (!string.IsNullOrEmpty(category.Description))
                {
                    <p class="category-desc">@category.Description</p>
                }

                <div class="menu-category-divider"></div>

                <div class="row g-3">
                    @if (category.MenuItems.Any())
                    {
                        foreach (var item in category.MenuItems)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="menu-item-card">

                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="@item.ImagePath" class="menu-item-img" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="menu-item-img-placeholder">🍴</div>
                                    }

                                    <div class="menu-item-body">
                                        <div class="menu-item-name">@item.Name</div>

                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div class="menu-item-desc">@item.Description</div>
                                        }

                                        <div class="menu-item-footer">
                                            <span class="menu-item-price">₹@item.Price.ToString("0.00")</span>

                                            <form method="post" action="@Url.Action("Add", "Cart")">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                                <button type="submit" class="btn btn-add-cart">
                                                    🛒 Add
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }
                    }
                </div>

            </div>
        }
    }
    else
    {
        <div class="menu-empty">
            <div class="menu-empty-emoji">🍽️</div>
            <h4>No Menu Available</h4>
            <p>Menu items will be available soon.</p>
        </div>
    }

</div>
