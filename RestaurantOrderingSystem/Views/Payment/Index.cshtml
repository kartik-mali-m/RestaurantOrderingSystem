@model RestaurantOrderingSystem.Models.Order.Order

@{
    ViewData["Title"] = "Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <div class="checkout-card mx-auto"
         style="max-width: 550px;">

        <div class="text-center mb-4">

            <h2>💳 Payment</h2>

            <p class="text-muted">
                Complete payment for your order
            </p>

        </div>

        <hr />

        <div class="d-flex justify-content-between mb-3">
            <span>Order ID</span>
            <strong>#@Model.Id</strong>
        </div>

        <div class="d-flex justify-content-between mb-3">
            <span>Customer</span>
            <strong>@Model.CustomerName</strong>
        </div>

        <div class="d-flex justify-content-between mb-3">
            <span>Order Type</span>
            <strong>@Model.OrderType</strong>
        </div>

        <hr />

        <div class="d-flex justify-content-between mt-3">

            <h4>Total Amount</h4>

            <h4>
                ₹@Model.TotalAmount.ToString("0.00")
            </h4>

        </div>

        <div class="mt-4">

            <button type="button"
                    class="btn btn-primary w-100 py-3"
                    disabled>

                💳 Pay ₹@Model.TotalAmount.ToString("0.00")

            </button>

        </div>

        <div class="text-center mt-3">

            <small class="text-muted">
                Payment gateway will be connected here.
            </small>

        </div>

    </div>

</div>