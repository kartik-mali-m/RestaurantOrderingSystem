@model RestaurantOrderingSystem.ViewModels.Auth.RestaurantRegisterVM

@{
    ViewData["Title"] = "Restaurant Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register Restaurant - Restaurant Ordering System</title>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
        }

        body {
            background-color: #f1f5f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
        }

        .register-card {
            width: 100%;
            max-width: 1050px;
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
            display: grid;
            grid-template-columns: 0.85fr 1.15fr;
            overflow: hidden;
            border: 1px solid #f0f0f0;
        }

        .register-hero {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #4338ca 100%);
            padding: 48px;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 24px;
            width: fit-content;
        }

        .register-hero h1 {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 12px;
            line-height: 1.2;
        }

        .register-hero p {
            color: #cbd5e1;
            font-size: 14px;
            line-height: 1.6;
        }

        .register-form-container {
            padding: 40px 48px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            max-height: 90vh;
            overflow-y: auto;
        }

        .form-header {
            margin-bottom: 24px;
        }

            .form-header h2 {
                font-size: 24px;
                font-weight: 750;
                color: #0f172a;
                margin-bottom: 4px;
            }

            .form-header p {
                font-size: 13px;
                color: #64748b;
            }

        .section-title {
            font-size: 12px;
            font-weight: 700;
            color: #4338ca;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin: 12px 0 8px;
            padding-bottom: 4px;
            border-bottom: 1px solid #e2e8f0;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

            .form-grid.full-width {
                grid-template-columns: 1fr;
            }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .form-label {
            font-size: 12px;
            font-weight: 650;
            color: #334155;
        }

        .input-icon-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 12px;
            font-size: 13px;
            opacity: 0.7;
            pointer-events: none;
        }

        .form-input {
            width: 100%;
            padding: 10px 12px 10px 36px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-size: 13px;
            color: #0f172a;
            background-color: #f8fafc;
            transition: all 0.2s ease;
        }

        textarea.form-input {
            padding-left: 36px;
            resize: vertical;
            min-height: 60px;
        }

        .form-input:focus {
            outline: none;
            border-color: #6366f1;
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

        .field-validation-error {
            color: #ef4444;
            font-size: 11px;
            font-weight: 600;
            margin-top: 2px;
        }

        .custom-validation-summary {
            color: #dc2626;
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 12px;
            margin-bottom: 14px;
        }

        .register-submit-btn {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
            margin-top: 16px;
        }

            .register-submit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(79, 70, 229, 0.35);
            }

        .login-prompt {
            text-align: center;
            margin-top: 16px;
            font-size: 13px;
            color: #64748b;
        }

        .login-btn {
            color: #4f46e5;
            font-weight: 700;
            text-decoration: none;
            margin-left: 4px;
        }

            .login-btn:hover {
                color: #3730a3;
                text-decoration: underline;
            }

        @@media (max-width: 900px) {
            .register-card

        {
            grid-template-columns: 1fr;
        }

        .register-hero {
            padding: 32px;
        }

        .register-form-container {
            padding: 32px;
            max-height: none;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        }
    </style>
</head>
<body>

    <div class="register-card">
        <!-- Left Side: Hero Section -->
        <div class="register-hero">
            <div class="brand-badge">
                <span>🍽️</span> Restaurant System
            </div>
            <h1>Partner With Us</h1>
            <p>Register your restaurant, customize your menu, and start receiving online orders instantly.</p>
        </div>

        <!-- Right Side: Registration Form -->
        <div class="register-form-container">
            <div class="form-header">
                <h2>Restaurant Registration</h2>
                <p>Provide your business and owner details below</p>
            </div>

            <form asp-controller="RestaurantRegistration"
                  asp-action="Register"
                  method="post"
                  enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="custom-validation-summary"></div>

                <!-- Restaurant Details -->
                <div class="section-title">Restaurant Details</div>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="RestaurantName" class="form-label">Restaurant Name</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">🏪</span>
                            <input asp-for="RestaurantName" class="form-input" placeholder="Tasty Bites" />
                        </div>
                        <span asp-validation-for="RestaurantName" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Phone" class="form-label">Phone Number</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">📞</span>
                            <input asp-for="Phone" class="form-input" placeholder="+1234567890" />
                        </div>
                        <span asp-validation-for="Phone" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Business Email</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">✉️</span>
                            <input asp-for="Email" class="form-input" placeholder="contact@restaurant.com" />
                        </div>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="GSTNumber" class="form-label">GST Number</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">📋</span>
                            <input asp-for="GSTNumber" class="form-input" placeholder="GSTIN123456" />
                        </div>
                        <span asp-validation-for="GSTNumber" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form-grid full-width" style="margin-top: 14px;">
                    <div class="form-group">
                        <label asp-for="Address" class="form-label">Address</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">📍</span>
                            <textarea asp-for="Address" class="form-input" placeholder="Full restaurant address..."></textarea>
                        </div>
                        <span asp-validation-for="Address" class="field-validation-error"></span>
                    </div>
                </div>
                <div class="form-grid full-width" style="margin-top: 14px;">
                    <div class="form-group">
                        <label asp-for="Logo" class="form-label">Restaurant Logo</label>

                        <div class="input-icon-wrapper">
                            <span class="input-icon">🖼️</span>

                            <input asp-for="Logo"
                                   type="file"
                                   class="form-input"
                                   accept=".jpg,.jpeg,.png,.webp" />
                        </div>

                        <span asp-validation-for="Logo"
                              class="field-validation-error"></span>
                    </div>
                </div>
                <!-- Owner Details -->
                <div class="section-title">Owner Account</div>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="OwnerName" class="form-label">Owner Full Name</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">👤</span>
                            <input asp-for="OwnerName" class="form-input" placeholder="John Doe" />
                        </div>
                        <span asp-validation-for="OwnerName" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="OwnerEmail" class="form-label">Owner Email</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">✉️</span>
                            <input asp-for="OwnerEmail" class="form-input" placeholder="owner@domain.com" />
                        </div>
                        <span asp-validation-for="OwnerEmail" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form-grid" style="margin-top: 14px;">
                    <div class="form-group">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">🔒</span>
                            <input asp-for="Password" type="password" class="form-input" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">🔒</span>
                            <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>
                </div>

                <button type="submit" class="register-submit-btn">
                    <span>Register Restaurant</span>
                    <span>→</span>
                </button>
            </form>

            <div class="login-prompt">
                Already registered?
                <a asp-controller="Auth" asp-action="Login" class="login-btn">Sign in here</a>
            </div>
        </div>
    </div>

</body>
</html>